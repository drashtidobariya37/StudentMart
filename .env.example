# Student Mart - Environment Configuration Template
# Copy this file to .env and customize for your local setup

# Flask Secret Key (used for cryptographically signing sessions and CSRF tokens)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production

# Flask Environment (development / production)
FLASK_ENV=development
FLASK_DEBUG=1
PORT=8000

# Database Configuration (SQLite for local development; PostgreSQL / MySQL / Persistent Disk for production)
DATABASE_URL=sqlite:///student_mart.db

# Optional Persistent Disk Storage Path (e.g., /var/data on Render or Docker volume)
# If set, database and uploads will automatically be stored inside this directory.
# PERSISTENT_STORAGE_PATH=/var/data

# File Upload Settings (Max 5MB per upload)
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=frontend/static/uploads

# Production HTTPS Cookie Security (set to true when live on Render HTTPS)
SESSION_COOKIE_SECURE=false

# Google OAuth 2.0 / OpenID Connect (Optional)
# If provided, enables "Sign in with Google" button.
# If empty, Student Mart gracefully displays a configuration guide and falls back to standard auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Razorpay Test Mode Payment Gateway (Optional)
# Obtain test credentials from Razorpay Dashboard -> Settings -> API Keys (begins with rzp_test_)
# If left empty, Student Mart automatically uses "Campus Safe Demo Escrow" checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# Application Branding
MARKETPLACE_NAME=Student Mart
SUPPORT_EMAIL=support@studentmart.campus
DEFAULT_CITY=Bengaluru, India
